---
import "../styles/global.css";
import Header from "../components/Header.astro";
import '@fontsource-variable/onest/wght.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Portfolio de Mateo Cardonnet — Desarrollador Full Stack, estudiante de Ingeniería en Sistemas. Proyectos, stack tecnológico y contacto." />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Portfolio de Mateo" />
		<meta property="og:description" content="Desarrollador Full Stack y estudiante de Ingeniería en Sistemas. Proyectos, stack tecnológico y contacto." />
		<meta property="og:image" content="/og-image.webp" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Portfolio de Mateo" />
		<meta name="twitter:description" content="Desarrollador Full Stack y estudiante de Ingeniería en Sistemas." />
		<meta name="twitter:image" content="/og-image.webp" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<div class=" fixed inset-0 top-0 z-[-2] h-screen w-screen bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-10%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		<Header />
		<slot />
	</body>
</html>

<style is:global>
	:root{
		color-scheme: light dark;
	}

	html {
		font-family: 'Onest Variable', system-ui, sans-serif;
		line-height: 1.5;
		scroll-behavior: smooth;
	}

	body{
		display: flex;
		justify-content: center;
		flex-direction: column;
		color: white;
		min-height: 100vh;
	}
</style>
