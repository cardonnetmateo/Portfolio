---
import Layout from '../layouts/Layout.astro';
import SocialPill from '../components/SocialPill.astro';
import Linkedin from '../components/icons/Linkedin.astro';
import Github from '../components/icons/GitHub.astro';
import Mail from '../components/icons/Mail.astro';
import Devto from '../components/icons/Dev.astro';
import ProyectCard from '../components/ProyectCard.astro';
import StackCard from '../components/StackCard.astro';
import TechPill from '../components/TechPill.astro';
import HtmlIcon from '../components/icons/Html.astro';
import CssIcon from '../components/icons/Css.astro';
import JsIcon from '../components/icons/Js.astro';
import TsIcon from '../components/icons/Ts.astro';
import ReactIcon from '../components/icons/React.astro';
import AngularIcon from '../components/icons/Angular.astro';
import TailwindIcon from '../components/icons/Tailwind.astro';
import NextjsIcon from '../components/icons/Nextjs.astro';
import JavaIcon from '../components/icons/Java.astro';
import PythonIcon from '../components/icons/Python.astro';
import SpringBootIcon from '../components/icons/SpringBoot.astro';
import DjangoIcon from '../components/icons/Django.astro';
import NestjsIcon from '../components/icons/Nestjs.astro';
import PostgresSqlIcon from '../components/icons/PostgresSql.astro';
import MongoDbIcon from '../components/icons/MongoDb.astro';
import GitIcon from '../components/icons/Git.astro';
import DockerIcon from '../components/icons/Docker.astro';
import N8nIcon from '../components/icons/N8n.astro';
import MockitoIcon from '../components/icons/Mockito.astro';
import VitestIcon from '../components/icons/Vitest.astro';
import ZodIcon from '../components/icons/Zod.astro';
import NodejsIcon from '../components/icons/Nodejs.astro';
import PostmanIcon from '../components/icons/Postman.astro';
import OrmIcon from '../components/icons/Orm.astro';
---

<Layout title = "Portfolio de Mateo">
    <main>
        <section class="w-full lg:w-185 mx-auto px-4 lg:px-0 h-[calc(100svh-14rem)] flex flex-col justify-center py-20">
            <h1 class="text-4xl font-bold">Hola, <span class="text-indigo-400">soy Mateo</span></h1>
            <h2 class="text-sm font-semibold mb-6 text-indigo-300">Desarrollador Fullstack</h2>
            <p class="text-lg text-gray-300 py-6">
                Desarrollador de software y estudiante de Ingeniería en Sistemas enfocado en la creación de aplicaciones web y soluciones para problemas reales.
            </p>
            <div class="mb-6 flex flex-wrap py-6 gap-2">
                <a href="https://www.linkedin.com/in/mateo-cardonnet-2669422b2/" target="_blank" rel="noopener noreferrer">
                    <SocialPill><Linkedin class="size-5 mr-2"/>Linkedin</SocialPill>
                </a>
                <a href="https://github.com/cardonnetmateo" target="_blank" rel="noopener noreferrer">
                    <SocialPill><Github class="size-5 mr-2"/>GitHub</SocialPill>
                </a>
                <a href="mailto:cardonnetmateo@gmail.com">
                    <SocialPill><Mail class="size-5 mr-2"/>cardonnetmateo@gmail.com</SocialPill>
                </a>
                <a href="#proyectos">
                    <SocialPill><Devto class="size-5 mr-2"/>Proyectos</SocialPill>
                </a>
            </div>
        </section>

        <section id="proyectos" class="w-full lg:w-270 mx-auto px-4 lg:px-0 pt-10 pb-60 scroll-mt-28">
            <h2 class="text-2xl font-bold text-center transition-transform duration-300 hover:scale-105">
                Proyectos <span class="inline-block animate-bounce">⬇️</span>
            </h2>
            <div class="mt-10 flex flex-col items-center gap-16">
                <ProyectCard folder="proyecto1" title="Sistema Estacionamiento" description="Gestión de estacionamientos con <strong>control de ingresos/egresos</strong>, <strong>cuentas corrientes</strong>, <strong>abonos mensuales</strong> y <strong>recarga de saldo</strong>. Full Stack con Java Spring Boot, Next.js y PostgreSQL. Testing con Mockito y Vitest. Utilizacion de docker" link="https://github.com/cardonnetmateo/Sistema-Estacionamiento" />
                <ProyectCard folder="proyecto2" title="MarketHub" description="Plataforma de gestión de productos y usuarios enfocada en la <strong>seguridad</strong>, con <strong>autenticación JWT</strong>, <strong>autorización por roles</strong> y <strong>verificación por correo</strong>. Full Stack con NestJS, Angular y Sqlite3. Utilizacion de docker" link="https://github.com/cardonnetmateo/TPF-DESARROLLO" />
            </div>
        </section>

        <!-- seccion sobre mi -->
        <section id="sobre-mi" class="w-full lg:w-185 mx-auto px-4 lg:px-0 pb-60 scroll-mt-28">
            <h2 class="text-2xl font-bold text-left transition-transform duration-300 hover:scale-105">
                Sobre mí
            </h2>
            <div class="mt-10 flex flex-col md:flex-row items-center gap-8">
                <div class="flex flex-col gap-4 text-zinc-300">
                    <p class="text-lg">Soy estudiante de Ingeniería en Sistemas y desarrollador de software enfocado en la creación de aplicaciones web y soluciones para problemas reales.</p>
                    <p class="text-lg">Me interesa el desarrollo full stack y disfruto participar en todas las etapas de un proyecto: desde el diseño de la interfaz hasta la lógica de negocio, las bases de datos y el despliegue.</p>
                    <p class="text-lg">Como parte de mi formación, desarrollo proyectos personales que me permiten aplicar tecnologías y buenas prácticas utilizadas en el ámbito profesional. Entre ellos, he construido aplicaciones utilizando React, Next.js, Astro, Angular, NestJS, Spring Boot, Django, JavaScript, Python, Java, SQL, Tailwind CSS, automatizaciones con n8n y testing con Mockito y Vitest.</p>
                    <p class="text-lg text-indigo-400 font-semibold">Full Stack Developer | Automation & AI Solutions | Estudiante de Ingeniería en Sistemas</p>
                    <div class="flex flex-wrap gap-2">
                        <SocialPill><Github class="size-5 mr-2" /><a href="https://github.com/cardonnetmateo" target="_blank" rel="noopener noreferrer">cardonnetmateo</a></SocialPill>
                        <SocialPill><a href="/curriculum.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center">📄 Curriculum</a></SocialPill>
                    </div>
                </div>
            </div>
        </section>

        <!-- seccion stack tecnologico -->
        <section id="stack" class="w-full lg:w-185 mx-auto px-4 lg:px-0 pb-30 scroll-mt-28">
            <h2 class="text-2xl font-bold text-left transition-transform duration-300 hover:scale-105">
                Stack tecnológico
            </h2>
            <div class="mt-10 grid gap-6 md:grid-cols-2">
                <StackCard title="Frontend">
                    <TechPill><HtmlIcon class="size-4" />HTML</TechPill>
                    <TechPill><CssIcon class="size-4" />CSS</TechPill>
                    <TechPill><JsIcon class="size-4" />JavaScript</TechPill>
                    <TechPill><TsIcon class="size-4" />TypeScript</TechPill>
                    <TechPill><ReactIcon class="size-4" />React.js</TechPill>
                    <TechPill><AngularIcon class="size-4" />Angular</TechPill>
                    <TechPill><TailwindIcon class="size-4" />Tailwind CSS</TechPill>
                    <TechPill><NextjsIcon class="size-4" />Next.js</TechPill>
                    <TechPill><VitestIcon class="size-4" />Vitest</TechPill>
                </StackCard>
                <StackCard title="Backend">
                    <TechPill><JavaIcon class="size-4" />Java</TechPill>
                    <TechPill><PythonIcon class="size-4" />Python</TechPill>
                    <TechPill><SpringBootIcon class="size-4" />Spring Boot</TechPill>
                    <TechPill><DjangoIcon class="size-4" />Django</TechPill>
                    <TechPill><NestjsIcon class="size-4" />NestJS</TechPill>
                    <TechPill><PostgresSqlIcon class="size-4" />PostgreSQL</TechPill>
                    <TechPill><MongoDbIcon class="size-4" />MongoDB</TechPill>
                    <TechPill><MockitoIcon class="size-4" />Mockito</TechPill>
                </StackCard>
                <StackCard title="Herramientas" class="md:col-span-2">
                    <TechPill><Github class="size-4" />GitHub</TechPill>
                    <TechPill><GitIcon class="size-4" />Git</TechPill>
                    <TechPill><DockerIcon class="size-4" />Docker</TechPill>
                    <TechPill><N8nIcon class="size-4" />n8n</TechPill>
                    <TechPill><ZodIcon class="size-4" />Zod</TechPill>
                    <TechPill><NodejsIcon class="size-4" />Node.js</TechPill>
                    <TechPill><PostmanIcon class="size-4" />Postman</TechPill>
                    <TechPill><OrmIcon class="size-4" />ORM</TechPill>
                </StackCard>
            </div>
        </section>

    </main>
</Layout>
